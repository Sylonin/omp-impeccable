{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "types": ["node"]
  },
  "include": [
    "extensions/**/*.ts",
    "extensions/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}
